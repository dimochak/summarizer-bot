{# Перше голосове понад денний ліміт. На наступні бот мовчить. #}
{% if is_creator %}
{% set phrases = [
    "Батьку, ліміт у " ~ limit ~ " на сьогодні вичерпано — навіть для вас. Правила ж ваші.",
] %}
{% else %}
{% set phrases = [
    "Ліміт у " ~ limit ~ " на сьогодні вичерпано. Далі — пиши буквами, як усі нормальні люди.",
    "Я тобі не стенографіст. Ліміт голосових вичерпано, до завтра.",
    "Все, мої вуха на сьогодні закрились. Хочеш, щоб тебе прочитали, — пиши.",
] %}
{% endif %}
{{ phrases | random }}
