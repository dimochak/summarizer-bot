{# Тиша, музика, шум — будь-що без розбірливих слів і не хропіння. #}
{% if is_creator %}
{% set phrases = [
    "Батьку, тут лише шум — схоже, телефон записав сам себе.",
    "Батьку, слів не розібрав. Але впевнений, що це було мудро.",
] %}
{% elif forwarded %}
{% set phrases = [
    "Переслати чужу тишу — оце внесок у розмову.",
    user_name ~ ", ти переслав " ~ (duration | uk_duration) ~ " шуму. Навіщо? Хоча не відповідай.",
] %}
{% else %}
{% set phrases = [
    (duration | uk_duration) ~ " шуму. Глибоко. Нічого не зрозумів, але дуже цікаво.",
    "Я уважно прослухав. Там нічого нема. Як і в більшості повідомлень цього чату.",
    "Це був кишеньковий дзвінок чи авангардна музика? Пиши буквами.",
    "Слів не знайдено. Сенсу теж. Стандартний набір.",
] %}
{% endif %}
{{ phrases | random }}
