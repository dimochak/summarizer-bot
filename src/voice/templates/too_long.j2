{# Задовге голосове: не завантажуємо й не розшифровуємо. #}
{% if is_creator %}
{% set phrases = [
    "Батьку, " ~ (duration | uk_duration) ~ " — забагато навіть для мене. Може, текстом?",
] %}
{% else %}
{% set phrases = [
    (duration | uk_duration) ~ "? Я не подкаст-платформа. Пиши буквами.",
    "Ні. Я не слухатиму " ~ (duration | uk_duration) ~ ". Конспект напиши сам.",
    "Аудіокнига? Видавництво — в іншому чаті.",
] %}
{% endif %}
{{ phrases | random }}
