{# Вступ перед розшифровкою. Фраза — одна навмання з відповідного списку. #}
{% if is_creator %}
{% set phrases = [
    "Батьку, розшифрував ваше слово для тих, хто не вміє слухати:",
    "Ваше голосове, батьку, увічнено в тексті:",
    "Слухаюсь і записую, батьку:",
] %}
{% elif forwarded %}
{% set phrases = [
    "Мало того, що голосове, так ще й чуже. Пересилати чужі голосові — окремий рівень лінощів.",
    "Переказати своїми словами — ні, це ж треба думати. Краще переслати. Розшифровка:",
    user_name ~ ", ти тепер листоноша чужих голосових? Розшифровую, раз ніхто не хоче:",
    "Своїх голосових мало, тягнемо чужі. Ось що там:",
] %}
{% elif media == "video_note" %}
{% set phrases = [
    "Кружечок? Серйозно? Ми й так знаємо, як ти виглядаєш. Ось текст:",
    "Невже так складно писати буквами, що треба ще й камеру вмикати?",
    "Режисерський дебют у форматі кружечка. Сценарій додаю:",
    "Обличчя — в кружечку, сенс — у розшифровці. Якщо він там є:",
] %}
{% else %}
{% set phrases = [
    "Невже так складно писати буквами?",
    "Клавіатура в ремонті чи пальці у відпустці?",
    "Голосові в груповому чаті — окреме коло пекла. Розшифровую для тих, хто на нараді:",
    (duration | uk_duration) ~ " мого життя, які ніхто не поверне. Ось що там було:",
    "О, подкаст! Ніхто не замовляв, але ось текстова версія:",
    "Пальці зламались? Співчуваю. Тримай розшифровку:",
    "Хтось переплутав чат із батьківським комітетом. Розшифровую:",
] %}
{% endif %}
{{ phrases | random }}
