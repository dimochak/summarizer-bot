{# Голосове, де лише хропіння і жодного слова. #}
{% if is_creator %}
{% set phrases = [
    "Батьку, ви, здається, задрімали. Відпочивайте, я почергую.",
    "Батьку, навіть ваше хропіння звучить велично. Але, може, час прокидатись?",
] %}
{% elif forwarded %}
{% set phrases = [
    "Пересилати чуже хропіння — це вже якийсь окремий фетиш. Розбуди краще автора.",
    user_name ~ ", навіщо нам чуже хропіння? Іди розбуди того, хто це записав.",
    "Хтось хропе, а ти це розносиш по чатах. Прокидайтесь обоє.",
] %}
{% elif media == "video_note" %}
{% set phrases = [
    "Кружечок зі сплячим обличчям — новий жанр. Прокидайся!",
    "Камера працює, мозок — ні. Підйом!",
    "Прокидайся! Ти навіть кружечок записуєш уві сні.",
] %}
{% else %}
{% set phrases = [
    "Прокидайся! У чат щойно прилетіло твоє хропіння.",
    "Це було голосове чи заявка на конкурс тракторів? Прокидайся.",
    "Навіть я, бот без вух, чую, що це хропіння. Підйом!",
    "Хропіння отримано, розшифровано й заархівовано. Доброго ранку, соня.",
    "Розшифровка: «хр-р-р… пс-с-с… хр-р-р». Прокидайся, бо все проспиш.",
    "Телефон у ліжку — ворог людства. Прокидайся!",
] %}
{% endif %}
{{ phrases | random }}
